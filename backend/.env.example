# App
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=riverline

# Agent defaults
AGENT_NAME=Paisa

# OpenAI (used by the self-hosted Pipecat worker)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://smarthelio-agents-resource.openai.azure.com/openai/v1
OPENAI_MODEL=gpt-realtime-2.1-mini

# Daily (transport for calls)
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1
DAILY_ROOM_EXPIRE_SECONDS=3600
DAILY_TOKEN_EXPIRE_SECONDS=1800

# Pipecat (self-hosted worker config)
PIPECAT_BOT_NAME=paisa-voice-agent
PIPECAT_LOG_LEVEL=info
